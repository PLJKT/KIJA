name: Update KIJA Share Price

on:
  schedule:
    # Run weekdays at 16:30 WIB (09:30 UTC) = after IDX close (15:00 WIB)
    - cron: '30 9 * * 1-5'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-price:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install requests

      - name: Fetch latest price and update data.json
        run: python .github/scripts/update_price.py

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data.json
          if git diff --staged --quiet; then
            echo "No price update needed"
          else
            git commit -m "chore: auto-update share price $(date -u +%Y-%m-%d)"
            git push
          fi
